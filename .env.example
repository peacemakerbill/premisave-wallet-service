# ==================== Commission, exchange rates, notifications ====================
COMMISSION_INTERNAL_TRANSFER_RATE=0.01
COMMISSION_GATEWAY_RATE=0.03
EXCHANGE_RATE_REFRESH_INTERVAL_MS=600000
EXCHANGE_RATE_BASE_CURRENCY=USD
EXCHANGE_RATE_MAX_RETRIES=3
# Comma separated addresses told about B2B notifications
B2B_NOTIFICATION_RECIPIENTS=

# ==================== Commercial API: general ====================
COMMERCIAL_ENABLED=true
COMMERCIAL_SERVES=both
COMMERCIAL_CURRENCIES=USD,KES
COMMERCIAL_SANDBOX_REDIRECT_BASE=https://sandbox.invalid
# Request signing. When enabled, set the same secret as WALLET_SIGNING_SECRET in developer-service.
COMMERCIAL_SIGNING_ENABLED=false
COMMERCIAL_SIGNING_SECRETS=

# ==================== Commercial API: events to developer-service ====================
# Leave DEVELOPER_SERVICE_URL empty until developer-service accepts events (POST /internal/events).
# With an address set before then, every delivery fails and is retried. Events wait safely in the outbox.
DEVELOPER_SERVICE_URL=
DEVELOPER_SERVICE_API_KEY=
COMMERCIAL_EVENTS_SIGNING_SECRET=
# Set false to stop sending events to developer-service (they stay in the outbox)
COMMERCIAL_EVENTS_DISPATCHER_ENABLED=true

# ==================== Commercial API: merchant onboarding ====================
COMMERCIAL_ONBOARDING_ENABLED=true
# Addresses told when an application is submitted or resubmitted, comma separated
COMMERCIAL_ONBOARDING_STAFF_EMAILS=review@your-domain.com
# Sender of onboarding emails. Empty uses the mail account's own address.
COMMERCIAL_ONBOARDING_MAIL_FROM=

# ==================== Commercial API: onboarding document storage ====================
# Identity and tax documents are written to a folder on this server. The service never connects to a
# file server itself: for a NAS, a Windows share or an office server (also over a VPN), mount it on
# this server first (fstab or systemd) and use NETWORK mode. See "Document folder setup" in the README.
#
# LOCAL   keep documents in STORAGE_ROOT on this server's disk.
# NETWORK keep documents in STORAGE_NETWORK_DIRECTORY on the share mounted at STORAGE_NETWORK_MOUNT_PATH
#         (STORAGE_ROOT is ignored). Any other value stops the service at startup.
STORAGE_MODE=LOCAL
# LOCAL only: an existing folder the service user can write to
# (COMMERCIAL_ONBOARDING_STORAGE_PATH is the old name and is still read when this is empty)
STORAGE_ROOT=/home/graham218/MyProjects/file-storage/Premisave-Wallet/

# NETWORK only
# SMB (Windows share, Samba, Synology), NFS, SFTP (sshfs), WEBDAV or OTHER (no type check)
STORAGE_NETWORK_PROTOCOL=SMB
# Optional but recommended: the mount must come from this server and share, written as in /etc/fstab
# (for a VPN use the file server's VPN address)
STORAGE_NETWORK_HOST=
STORAGE_NETWORK_SHARE=
# The local folder the share is mounted on, for example /mnt/nas
STORAGE_NETWORK_MOUNT_PATH=
# Sub folder on the share for this service. Created on the share at startup if missing.
STORAGE_NETWORK_DIRECTORY=premisave-wallet
# true: refuse reads and writes unless the mount path is really a mounted share, so a dropped VPN or
# NAS gives 503 instead of saving files on the local disk. Use false only on macOS or Windows dev machines.
STORAGE_NETWORK_REQUIRE_MOUNT=true

# ==================== Commercial API: payment links ====================
COMMERCIAL_LINKS_CHECKOUT_BASE_URL=
COMMERCIAL_LINKS_SANDBOX_CHECKOUT_BASE_URL=

# ==================== Commercial API: rails (all off until configured) ====================
COMMERCIAL_MPESA_ENABLED=false
COMMERCIAL_MPESA_CALLBACK_BASE_URL=
COMMERCIAL_MPESA_CALLBACK_SECRET=
COMMERCIAL_C2B_ENABLED=false
COMMERCIAL_C2B_SHORTCODE=
COMMERCIAL_STRIPE_ENABLED=false
COMMERCIAL_STRIPE_PUBLISHABLE_KEY=
COMMERCIAL_STRIPE_WEBHOOK_SECRET=
COMMERCIAL_PAYPAL_ENABLED=false
COMMERCIAL_FLUTTERWAVE_ENABLED=false
COMMERCIAL_NOWPAYMENTS_ENABLED=false
COMMERCIAL_PREMISAVE_ENABLED=false

# ==================== Escrow (/internal/escrow/**) ====================
# initiatedBy values allowed to use the escrow endpoints (comma separated). Empty switches the check off.
ESCROW_ALLOWED_INITIATORS=LISTING_SERVICE
# A hold or payout still PENDING after this many minutes is settled by the recovery sweep.
ESCROW_STALE_PENDING_MINUTES=5
# How often the recovery sweep runs, in milliseconds.
ESCROW_RECOVERY_INTERVAL_MS=60000
