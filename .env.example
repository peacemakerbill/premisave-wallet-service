# ==================== Database ====================
MONGODB_URI=mongodb://localhost:27017/premisave-wallet

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# ==================== Auth Service ====================
AUTH_SERVICE_URL=http://localhost:8080
JWT_SECRET=eW91ci12ZXJ5LXNlY3VyZS1qd3Qtc2VjcmV0LWtleS0zMi1ieXRlcyE=

# ==================== Internal service-to-service auth ====================
# Presented as the X-API-Key header by other Premisave services (e.g.
# property-service's WalletServiceFeignConfig) when calling this service's
# /internal/** endpoints. Validated by InternalApiKeyFilter.
#
# IMPORTANT: this must be the EXACT SAME STRING as INTERNAL_API_KEY in
# property-service's .env and in developer-service's .env (the developer service
# sends it on every call to /internal/commercial/**) — generate one shared secret
# and use it in all of them.
INTERNAL_API_KEY=replace-with-a-shared-secret-matching-property-service

# ==================== Mail (Gmail SMTP) ====================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ==================== Frontend ====================
FRONTEND_URL=http://localhost:3000

# ==================== M-Pesa Daraja ====================
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey_here
MPESA_CALLBACK_URL=https://your-public-domain.com/wallet/payments/mpesa/callback
MPESA_ENV=sandbox
# Safaricom's public certificate, used to build the SecurityCredential from each initiator password.
# Sandbox and production certificates are different files. Production: certs/ProductionCertificate.cer
MPESA_CERT_PATH=certs/SandboxCertificate.cer

# ── B2C (Business to Customer — disbursements/payouts) ──
MPESA_B2C_INITIATOR_NAME=your_b2c_initiator_name
MPESA_B2C_INITIATOR_PASSWORD=your_b2c_initiator_password
# Base64 X.509-encrypted initiator password — generate with Daraja public cert
MPESA_B2C_SECURITY_CREDENTIAL=your_b2c_security_credential
MPESA_B2C_SHORTCODE=600000
MPESA_B2C_COMMAND_ID=BusinessPayment
MPESA_B2C_TIMEOUT_URL=https://your-public-domain.com/wallet/payments/mpesa/b2c/timeout
MPESA_B2C_RESULT_URL=https://your-public-domain.com/wallet/payments/mpesa/b2c/result

# ── B2B (Business to Business) ──
MPESA_B2B_INITIATOR_NAME=your_b2b_initiator_name
MPESA_B2B_INITIATOR_PASSWORD=your_b2b_initiator_password
MPESA_B2B_SECURITY_CREDENTIAL=your_b2b_security_credential
MPESA_B2B_SHORTCODE=600000
MPESA_B2B_RECEIVER_SHORTCODE=600001
MPESA_B2B_COMMAND_ID=BusinessPayBill
MPESA_B2B_SENDER_IDENTIFIER_TYPE=4
MPESA_B2B_RECEIVER_IDENTIFIER_TYPE=4
MPESA_B2B_TIMEOUT_URL=https://your-public-domain.com/wallet/payments/mpesa/b2b/timeout
MPESA_B2B_RESULT_URL=https://your-public-domain.com/wallet/payments/mpesa/b2b/result

# ── C2B (Customer to Business — Register/Validation/Confirmation) ──
MPESA_C2B_SHORTCODE=174379
MPESA_C2B_RESPONSE_TYPE=Completed
MPESA_C2B_VALIDATION_URL=https://your-public-domain.com/wallet/payments/mpesa/c2b/validation
MPESA_C2B_CONFIRMATION_URL=https://your-public-domain.com/wallet/payments/mpesa/c2b/confirmation

# ── Transaction Status API ──
MPESA_STATUS_INITIATOR_NAME=your_status_initiator_name
MPESA_STATUS_INITIATOR_PASSWORD=your_status_initiator_password
MPESA_STATUS_SECURITY_CREDENTIAL=your_status_security_credential
MPESA_STATUS_PARTY_A=600000
MPESA_STATUS_IDENTIFIER_TYPE=4
MPESA_STATUS_TIMEOUT_URL=https://your-public-domain.com/wallet/payments/mpesa/status/timeout
MPESA_STATUS_RESULT_URL=https://your-public-domain.com/wallet/payments/mpesa/status/result

# ── Account Balance / Pull Transactions API ──
MPESA_PULL_INITIATOR_NAME=your_pull_initiator_name
MPESA_PULL_INITIATOR_PASSWORD=your_pull_initiator_password
MPESA_PULL_SECURITY_CREDENTIAL=your_pull_security_credential
MPESA_PULL_SHORTCODE=600000
# The Safaricom number tied to this shortcode's KYC, from the M-PESA portal
MPESA_PULL_NOMINATED_NUMBER=your_nominated_number
# Pull API onboarding is a one-time registration with Safaricom
MPESA_PULL_REGISTER_URL=https://your-public-domain.com/wallet/payments/mpesa/pull/register
MPESA_PULL_CALLBACK_URL=https://your-public-domain.com/wallet/payments/mpesa/pull/callback
MPESA_PULL_DAYS=1
MPESA_PULL_OFFSET=0

# ── Account Balance API ──
MPESA_BALANCE_INITIATOR_NAME=your_balance_initiator_name
MPESA_BALANCE_INITIATOR_PASSWORD=your_balance_initiator_password
MPESA_BALANCE_PARTY_A=600000
MPESA_BALANCE_IDENTIFIER_TYPE=4
MPESA_BALANCE_TIMEOUT_URL=https://your-public-domain.com/wallet/payments/mpesa/balance/timeout
MPESA_BALANCE_RESULT_URL=https://your-public-domain.com/wallet/payments/mpesa/balance/result

# ── Reversal API ──
MPESA_REVERSAL_INITIATOR_NAME=your_reversal_initiator_name
MPESA_REVERSAL_INITIATOR_PASSWORD=your_reversal_initiator_password
MPESA_REVERSAL_RECEIVER_PARTY=600000
MPESA_REVERSAL_RECEIVER_IDENTIFIER_TYPE=11
MPESA_REVERSAL_TIMEOUT_URL=https://your-public-domain.com/wallet/payments/mpesa/reversal/timeout
MPESA_REVERSAL_RESULT_URL=https://your-public-domain.com/wallet/payments/mpesa/reversal/result

# ── Pochi la Biashara payouts ──
MPESA_POCHI_INITIATOR_NAME=your_pochi_initiator_name
MPESA_POCHI_INITIATOR_PASSWORD=your_pochi_initiator_password
MPESA_POCHI_PARTY_A=600000
MPESA_POCHI_TIMEOUT_URL=https://your-public-domain.com/wallet/payments/mpesa/pochi/timeout
MPESA_POCHI_RESULT_URL=https://your-public-domain.com/wallet/payments/mpesa/pochi/result

# ==================== Cloudinary (optional for receipts) ====================
CLOUDINARY_CLOUD_NAME=thepeacemakersllc
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==================== Stripe ====================
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here
STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/wallet/stripe/refresh
STRIPE_CONNECT_RETURN_URL=http://localhost:3000/wallet/stripe/return
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_your_connect_secret_here

# ==================== PayPal ====================
PAYPAL_CLIENT_ID=your_client_id
PAYPAL_CLIENT_SECRET=your_client_secret
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=your_webhook_id
PAYPAL_RETURN_URL=http://localhost:3000/wallet/paypal/return
PAYPAL_CANCEL_URL=http://localhost:3000/wallet/paypal/cancel

# ==================== Flutterwave v4 ====================
FLUTTERWAVE_CLIENT_ID=your_client_id
FLUTTERWAVE_CLIENT_SECRET=your_client_secret
FLUTTERWAVE_ENCRYPTION_KEY=your_encryption_key
FLUTTERWAVE_ENV=sandbox
FLUTTERWAVE_WEBHOOK_SECRET_HASH=your_webhook_secret_hash
FLUTTERWAVE_REDIRECT_URL=http://localhost:3000/wallet/flutterwave/return
FLUTTERWAVE_SANDBOX_SCENARIO_KEY=

# ==================== NOWPayments ====================
NOWPAYMENTS_BASE_URL=https://api-sandbox.nowpayments.io
NOWPAYMENTS_API_KEY=your_api_key
NOWPAYMENTS_IPN_SECRET=your_ipn_secret
NOWPAYMENTS_CALLBACK_URL=https://your-public-domain.com/wallet/payments/nowpayments/callback
NOWPAYMENTS_PAYOUT_EMAIL=
NOWPAYMENTS_PAYOUT_PASSWORD=

# ==================== Commission, exchange rates, notifications ====================
COMMISSION_INTERNAL_TRANSFER_RATE=0.01
COMMISSION_GATEWAY_RATE=0.03
EXCHANGE_RATE_REFRESH_INTERVAL_MS=600000
EXCHANGE_RATE_BASE_CURRENCY=USD
EXCHANGE_RATE_MAX_RETRIES=3
# Comma separated addresses told about B2B notifications
B2B_NOTIFICATION_RECIPIENTS=

# ==================== Commercial API: general ====================
COMMERCIAL_ENABLED=true
COMMERCIAL_SERVES=both
COMMERCIAL_CURRENCIES=USD,KES
COMMERCIAL_SANDBOX_REDIRECT_BASE=https://sandbox.invalid
# Request signing. When enabled, set the same secret as WALLET_SIGNING_SECRET in developer-service.
COMMERCIAL_SIGNING_ENABLED=false
COMMERCIAL_SIGNING_SECRETS=

# ==================== Commercial API: events to developer-service ====================
# DEVELOPER_SERVICE_URL is the developer service's address (for example http://localhost:8091). The developer
# search used when creating a merchant needs it, with DEVELOPER_SERVICE_API_KEY equal to DEVELOPER_INTERNAL_API_KEY there.
# The same address also turns on event delivery. Until developer-service accepts events (POST /internal/events),
# keep the dispatcher off so deliveries are not tried and fail: events then wait safely in the outbox.
DEVELOPER_SERVICE_URL=
DEVELOPER_SERVICE_API_KEY=
COMMERCIAL_EVENTS_DISPATCHER_ENABLED=false
COMMERCIAL_EVENTS_SIGNING_SECRET=

# ==================== Commercial API: merchant onboarding ====================
COMMERCIAL_ONBOARDING_ENABLED=true
# Addresses told when an application is submitted or resubmitted, comma separated
COMMERCIAL_ONBOARDING_STAFF_EMAILS=review@your-domain.com
# Sender of onboarding emails. Empty uses the mail account's own address.
COMMERCIAL_ONBOARDING_MAIL_FROM=
# Documents are stored in a Google Drive folder through a service account. Share the folder with the
# service account's email as Editor. Without Drive, document uploads return 503.
COMMERCIAL_DRIVE_ENABLED=false
COMMERCIAL_DRIVE_SERVICE_ACCOUNT_PATH=/path/to/service-account.json
# Alternative to the path: the key file's JSON itself
COMMERCIAL_DRIVE_SERVICE_ACCOUNT_JSON=
COMMERCIAL_DRIVE_FOLDER_ID=your_drive_folder_id

# ==================== Commercial API: payment links ====================
COMMERCIAL_LINKS_CHECKOUT_BASE_URL=
COMMERCIAL_LINKS_SANDBOX_CHECKOUT_BASE_URL=

# ==================== Commercial API: rails (all off until configured) ====================
COMMERCIAL_MPESA_ENABLED=false
COMMERCIAL_MPESA_CALLBACK_BASE_URL=
COMMERCIAL_MPESA_CALLBACK_SECRET=
COMMERCIAL_C2B_ENABLED=false
COMMERCIAL_C2B_SHORTCODE=
COMMERCIAL_STRIPE_ENABLED=false
COMMERCIAL_STRIPE_PUBLISHABLE_KEY=
COMMERCIAL_STRIPE_WEBHOOK_SECRET=
COMMERCIAL_PAYPAL_ENABLED=false
COMMERCIAL_FLUTTERWAVE_ENABLED=false
COMMERCIAL_NOWPAYMENTS_ENABLED=false
COMMERCIAL_PREMISAVE_ENABLED=false
